---
const today = new Date();
---

<footer>
  <div class="footer-inner">
    <span class="footer-brand">Mira</span>
    <span class="footer-sep">·</span>
    <span class="footer-copy">&copy; {today.getFullYear()} — Thời gian & Tự do tài chính</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    padding: 2rem 1.5rem;
    margin-top: 4rem;
  }

  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .footer-brand {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--color-text);
  }

  .footer-sep {
    color: var(--color-border);
  }
</style>
