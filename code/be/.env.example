# Chép file này thành `.env` rồi điền. `.env` đã gitignore.
#
# File này là thứ duy nhất nói cho người mới biết máy chủ cần gì để chạy, nên mỗi lần
# thêm một biến trong `src/env.ts` thì thêm luôn vào đây. Thiếu một dòng ở đây nghĩa là
# người tiếp theo clone về và không hiểu vì sao máy chủ không khởi động.

# ── Cơ sở dữ liệu (bắt buộc; thiếu thì máy chủ từ chối khởi động)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=mira_dev

# ── Máy chủ
PORT=8787
HOST=127.0.0.1
# Gốc web được phép gọi API, ngăn bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173

# ── Đăng nhập (bắt buộc)
# Khoá ký token. Dưới 32 ký tự thì máy chủ TỪ CHỐI KHỞI ĐỘNG: không có khoá đủ dài thì
# ai cũng tự phát token cho mình được. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Token sống bao lâu, tính bằng giây. Mặc định 30 ngày.
JWT_TTL_SEC=2592000

# ── Đăng nhập Google (tuỳ chọn)
# Rỗng = ẩn nút Google, `/auth/google` trả 503. KHÔNG phải bí mật: nó nằm công khai
# trong gói JS của web. Phải khớp y hệt `VITE_GOOGLE_CLIENT_ID` bên code/web.
# Lấy ở Google Cloud Console → Credentials → OAuth client ID → Web.
GOOGLE_CLIENT_ID=

# ── Giờ tỉnh (tuỳ chọn)
# Mẫu số của mọi tỉ lệ trên màn Thời gian. Để 16 mặc định thì người ngủ 7 tiếng sẽ thấy
# tỉ lệ cộng lại ra 106%, và không ai nhận ra vì donut vẫn vẽ ra hình tròn.
WAKING_HOURS_PER_DAY=16

# ── Đọc câu bằng AI cho màn chat (tuỳ chọn)
#
# ĐÂY LÀ BÍ MẬT THẬT, khác GOOGLE_CLIENT_ID ở trên. Nó không bao giờ được đi ra trình
# duyệt, và không bao giờ được commit.
#
# Rỗng thì màn chat VẪN CHẠY: tầng luật đọc được phần lớn câu (giờ, hạt, tiền) mà không
# cần mạng. Chỉ những câu luật chịu mới cần khoá, và lúc chưa có thì Mira nói thẳng là
# chưa cấu hình chứ không im lặng bỏ qua.
#
# Lấy ở console.anthropic.com → Settings → API Keys → Create Key, rồi nạp credit ở
# Billing. Khoá API tính tiền RIÊNG, không dùng chung gói thuê bao Claude.
ANTHROPIC_API_KEY=

# Mô hình đọc câu. Mặc định claude-opus-5-5, khoảng 5 phần nghìn đô mỗi câu phải nhờ AI.
# claude-haiku-5-5 rẻ hơn khoảng bốn mươi lần, đổi lại đoán kém hơn ở câu khó — mà câu
# khó mới là lúc cần tới nó.
CHAT_MODEL=claude-opus-5-5
