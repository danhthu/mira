# Gốc API cho bản phát hành. Vite nhúng giá trị này vào mã lúc `vite build`.
#
# Tên miền này đi qua Cloudflare Tunnel về máy của Founder — máy tắt là API tắt.
# Đổi sang máy chủ thật thì sửa đúng một dòng dưới đây, rồi sửa cả `connect-src`
# trong code/web/public/_headers, vì CSP chỉ mở đúng gốc này.
#
# Không có gì bí mật ở đây nên file này vào git; mật khẩu và JWT_SECRET nằm ở code/be/.env.
VITE_API_BASE_URL=https://mira-api.trady360.com

# Client ID của Google cho đăng nhập. KHÔNG phải bí mật — nó nằm công khai trong gói JS,
# và bảo mật đến từ việc máy chủ kiểm chữ ký chứ không từ việc giấu chuỗi này.
#
# Để trống = ẩn nút Google, màn đăng nhập chỉ còn đường mật khẩu, `/auth/google` trả 503.
#
# Lấy ở Google Cloud Console → APIs & Services → Credentials → OAuth client ID → Web:
#   Authorized JavaScript origins: https://mira.joybit.one  và  http://localhost:5173
#   (không có phần origins thì nút Google hiện ra nhưng bấm vào báo lỗi origin)
#
# Đặt xong ở đây thì phải đặt **cùng một giá trị** vào GOOGLE_CLIENT_ID trong code/be/.env,
# vì máy chủ dùng nó làm `aud`. Lệch nhau thì mọi lần đăng nhập đều 401.
VITE_GOOGLE_CLIENT_ID=
